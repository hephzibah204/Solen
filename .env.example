# Solen Environment Configuration Template
# Copy this file to .env and fill in your values

# ── DATABASE & SITE ────────────────────────────────────────────────────────
DB_PATH=database/solen.db
SITE_URL=https://getsolen.com
ADMIN_EMAIL=admin@getsolen.com

# ── MASTER ADMIN OVERRIDE ──────────────────────────────────────────────────
# Set these to manage/override your admin account
ADMIN_USER_EMAIL=admin@getsolen.com
ADMIN_USER_PASSWORD=

# ── AI PROVIDER KEYS ──────────────────────────────────────────────────────
# Main Chat & Intelligence
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
PUTER_AUTH_TOKEN=

# Advanced Memory (Embeddings)
COHERE_API_KEY=

# ── PAYMENT GATEWAY KEYS ──────────────────────────────────────────────────
STRIPE_PK=
STRIPE_SK=
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_PK=
FLUTTERWAVE_SK=
FLUTTERWAVE_ENCRYPTION=

PAYSTACK_PK=
PAYSTACK_SK=

# ── SMTP CONFIGURATION ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hello@getsolen.com
FROM_NAME=Solen

# ── SECURITY & CRON ───────────────────────────────────────────────────────
CRON_SECRET=
ENCRYPTION_SALT=
